{
  "name": "shurik",
  "version": "1.1.0",
  "description": "Reusable Pi Durable agent loops for GitHub Actions",
  "bin": {
    "shurik": "bin/shurik.ts"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "dist",
    "tests/worker.test.mjs",
    "tsconfig.json",
    "action.yml",
    "action"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "shurik": "node bin/shurik.ts",
    "check": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  },
  "private": true
}
